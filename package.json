{
  "name": "short-link-manager",
  "private": true,
  "type": "module",
  "scripts": {
"dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite --config client/vite.config.ts",
    "server:dev": "tsx watch server/src/server.ts",
    "build": "vite build --config client/vite.config.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mongoose": "^9.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
